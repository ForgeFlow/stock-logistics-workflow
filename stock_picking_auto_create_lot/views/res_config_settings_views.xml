<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.auto.create.lot</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <div id="full_traceability" position="after">
                <div class="col-12 col-lg-6 o_setting_box" id="auto_create_lot_setting">
                    <div class="o_setting_left_pane">
                        <field name="auto_create_lot" />
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="auto_create_lot" />
                        <div class="text-muted">
                            Allow automatic creation of lot/serial numbers.
                        </div>
                    </div>
                </div>
            </div>
        </field>
    </record>
</odoo>
